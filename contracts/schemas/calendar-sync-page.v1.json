{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donna.local/contracts/calendar-sync-page.v1.json",
  "title": "CalendarSyncPageV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "account_id", "events", "next_cursor", "source_updated_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "account_id": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "source_id", "calendar_id", "title", "starts_at", "ends_at", "location", "status", "updated_at"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "const": "google_calendar" },
          "source_id": { "type": "string", "minLength": 1 },
          "calendar_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "starts_at": { "type": "string", "format": "date-time" },
          "ends_at": { "type": "string", "format": "date-time" },
          "location": { "type": ["string", "null"] },
          "status": { "enum": ["confirmed", "tentative", "cancelled"] },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "next_cursor": { "type": ["string", "null"] },
    "source_updated_at": { "type": "string", "format": "date-time" }
  }
}
